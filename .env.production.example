# Copie para .env.production e ajuste no seu homelab.
# O docker-compose.prod.yml lê variáveis do shell ou de um arquivo .env (mesmo diretório).

# Porta externa do app (interno é 3000)
APP_PORT=3000

# Porta externa do Postgres (interno é 5432).
# Troque se 5432 já estiver em uso no homelab (ex: 5435).
DB_PORT=5432

# Senha do Postgres em produção. NÃO use "postgres" em produção real.
POSTGRES_PASSWORD=troque_esta_senha

# Chave da OpenAI. Sem ela o app continua usável; só /ai-diet e /coach mostram aviso.
OPENAI_API_KEY=

# Web Push (VAPID). Gere com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Bearer usado pelo sidecar cron para chamar /api/notifications/tick
# Gere com: openssl rand -base64 32
NOTIFICATIONS_TICK_SECRET=
