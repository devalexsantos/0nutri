# Banco de dados (PostgreSQL). No homelab troque a porta para a que estiver livre.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/zeronutri

# Chave da OpenAI para a funcionalidade "Montar Dieta com IA"
# Sem esta chave, /ai-diet exibirá um aviso e o app continua usável.
OPENAI_API_KEY=
